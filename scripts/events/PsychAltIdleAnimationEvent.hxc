package events;

import funkin.data.event.SongEventSchema;
import funkin.data.song.SongData.SongEventData;
import funkin.play.event.ScriptedSongEvent;
import funkin.play.PlayState;
import flixel.FlxG;
import Std;
import Math;

using StringTools;

class PsychAltIdleAnimationEvent extends ScriptedSongEvent
{
	public function new()
	{
		super("Alt Idle Animation");
	}

	override function handleEvent(data:SongEventData)
	{
    	if (PlayState.instance == null || PlayState.instance.currentStage == null) return;
		
		var target = null;
		var suffix = data.getString("value2");
		switch(data.getString("value1").toLowerCase().trim())
		{
			case 'bf' | 'boyfriend':
				target = PlayState.instance.currentStage.getBoyfriend();
			case 'gf' | 'girlfriend':
				target = PlayState.instance.currentStage.getGirlfriend();
			default:
				target = PlayState.instance.currentStage.getDad();
		}

		if (suffix == "")
		{
			target.shouldAlternate = target.hasAnimation('danceLeft');
			target.idleSuffix = '';
		}
		else
		{
			target.shouldAlternate = target.hasAnimation('danceLeft${suffix}');
			target.idleSuffix = suffix;
		}
	}

	override function getTitle():String
	{
		return "(Psych) Alt Idle Animation";
	}

	override function getEventSchema():SongEventSchema
	{
		return [
			{ name: "value1", title: "Value 1", type: "string", defaultValue: "" },
			{ name: "value2", title: "Value 2", type: "string", defaultValue: "" }
		];
	}
}