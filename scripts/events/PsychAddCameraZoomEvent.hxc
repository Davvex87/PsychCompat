package events;

import funkin.data.event.SongEventSchema;
import funkin.data.song.SongData.SongEventData;
import funkin.play.event.ScriptedSongEvent;
import funkin.play.PlayState;
import Std;
import Math;

using StringTools;

class PsychAddCameraZoomEvent extends ScriptedSongEvent
{
	public function new()
	{
		super("Add Camera Zoom");
	}

	override function handleEvent(data:SongEventData)
	{
    	if (PlayState.instance == null || PlayState.instance.currentStage == null) return;

		var camGameZoom:Float = Std.parseFloat(data.getString("value1"));
		var camHUDZoom:Float = Std.parseFloat(data.getString("value2"));

		if(Math.isNaN(camGameZoom)) camGameZoom = 0.015;
		if(Math.isNaN(camHUDZoom)) camHUDZoom = 0.03;
		
		PlayState.instance.cameraBopMultiplier += camGameZoom;
		PlayState.instance.camHUD.zoom += camHUDZoom;
	}

	override function getTitle():String
	{
		return "(Psych) Add Camera Zoom";
	}

	override function getEventSchema():SongEventSchema
	{
		return [
			{ name: "value1", title: "Value 1", type: "string", defaultValue: "0.015" },
			{ name: "value2", title: "Value 2", type: "string", defaultValue: "0.03" }
		];
	}
}